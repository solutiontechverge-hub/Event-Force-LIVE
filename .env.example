# Site Configuration
NEXT_PUBLIC_SITE_URL=https://eventforce.sa.com
NEXT_PUBLIC_SITE_NAME=Event Force
NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Maps (manage-booking pickup/dropoff map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Authentication & Security
NEXTAUTH_URL=https://eventforce.sa.com
NEXTAUTH_SECRET=your-nextauth-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-change-in-production

# Stripe (server — API route only)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# EmailJS (contact / booking emails — client)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_CONTACT=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_BOOKING=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# EmailJS (server-side — do not expose publicly)
EMAILJS_PRIVATE_KEY=

# Social Media API Keys (if needed for integrations)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Analytics & Tracking
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-M9M6XDBG
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# File Upload & Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eventforce-uploads

# Contact Information
CONTACT_EMAIL=Reservations@eventforce.sa.com
CONTACT_PHONE=+966594279012
CONTACT_ADDRESS=Saudi Arabia

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Environment
NODE_ENV=development
