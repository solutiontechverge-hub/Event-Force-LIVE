# =============================================================================
# Event Force LIVE — environment TEMPLATE (safe to commit)
# Copy to `.env.local` for local dev, or `/var/www/eventforce/.env` on the server.
# Replace every placeholder with real values. Never commit `.env.local` / `.env`.
# =============================================================================

# Site / domain (canonical production domain is eventforce.sa.com)
NEXT_PUBLIC_SITE_URL=https://eventforce.sa.com
NEXT_PUBLIC_BASE_URL=https://eventforce.sa.com
NEXT_PUBLIC_DOMAIN=https://eventforce.sa.com

# Google Maps (manage-booking pickup/dropoff)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# EmailJS (contact form + booking emails)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_CONTACT=your_emailjs_contact_template_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_BOOKING=your_emailjs_booking_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Server-only — from EmailJS dashboard → Account → API keys (Private Key)
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Stripe (checkout API route uses STRIPE_SECRET_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-M9M6XDBG
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Environment
NODE_ENV=development
